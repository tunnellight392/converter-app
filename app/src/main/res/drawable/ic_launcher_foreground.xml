<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Clean "convert" mark for Material You: two opposing swap arrows above a short
      ruler-tick row. Everything is solid white so it doubles as a crisp monochrome
      (themed) icon. Wrapped in a 0.9 group so the art stays inside any launcher mask.
    -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">

        <!-- Top arrow: points right -->
        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="7"
            android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M32,40 L60,40" />
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M58,32.5 L58,47.5 L74,40 Z" />

        <!-- Bottom arrow: points left -->
        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="7"
            android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M48,57 L76,57" />
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M50,49.5 L50,64.5 L34,57 Z" />

        <!-- Ruler tick row: baseline plus alternating tall/short ticks -->
        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3"
            android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M33,73 L75,73" />
        <path android:strokeColor="#FFFFFFFF" android:strokeWidth="3"
            android:strokeLineCap="round" android:fillColor="#00000000"
            android:pathData="M34,73 L34,65 M54,73 L54,65 M74,73 L74,65 M44,73 L44,68 M64,73 L64,68" />

    </group>
</vector>
