<resources>
    <!-- Base application theme. -->
    <style name="Theme.Converterapp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryVariant">@color/brand_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Transparent status bar; the app bar draws behind it. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <!-- Toolbar with light (white) title/icons for use on the brand color. -->
    <style name="Widget.Converterapp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/brand</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:theme">@style/ThemeOverlay.MaterialComponents.Dark.ActionBar</item>
        <!-- Keep the overflow popup light (dark text on white) so menu items stay readable;
             the Dark.ActionBar overlay above would otherwise make popup text white-on-white. -->
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
    </style>
</resources>
